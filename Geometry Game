<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wave Mode Game</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: #eee;
        }
        #top-bar {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 12px;
        }
        #back { color: #aaa; text-decoration: none; font-size: 0.9rem; }
        #back:hover { color: #00d4ff; }
        h1 { font-size: 1.3rem; color: #00d4ff; }
        canvas {
            border: 2px solid #333;
            display: block;
            cursor: pointer;
        }
        #instructions {
            margin-top: 12px;
            color: #666;
            font-size: 0.9rem;
            text-align: center;
        }
        #instructions span { color: #00d4ff; }
    </style>
</head>
<body>
    <div id="top-bar">
        <h1>🌊 Wave Mode</h1>
    </div>
    <canvas id="canvas" width="800" height="400"></canvas>
    <div id="instructions">
        Hold <span>SPACE</span> or hold <span>click/tap</span> to go up &nbsp;|&nbsp; Press <span>R</span> to restart
    </div>

    <script>
        const canvas = document.getElementById("canvas");
        const ctx = canvas.getContext("2d");

        const WIDTH = 800;
        const HEIGHT = 400;

        let player, velocityY, holding, obstacles, trail, score, gameOver, hue, animFrame;

        function initGame() {
            player = { x: 80, y: 200, w: 30, h: 30 };
            velocityY = 0;
            holding = false;
            obstacles = [];
            trail = [];
            score = 0;
            gameOver = false;
            hue = 0;
        }

        const gravity = 0.6;
        const wavePower = -1.3;

        function rainbow() {
            hue += 0.01;
            if (hue > 1) hue = 0;
            const h = hue * 360;
            return `hsl(${h}, 100%, 50%)`;
        }

        function getPlayerPoints() {
            return [
                { x: player.x, y: player.y },
                { x: player.x, y: player.y + player.h },
                { x: player.x + player.w, y: player.y + player.h / 2 }
            ];
        }

        function drawPlayer() {
            const pts = getPlayerPoints();
            ctx.fillStyle = "cyan";
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
            ctx.closePath();
            ctx.fill();
        }

        function addTrail() {
            const cx = player.x + player.w / 3;
            const cy = player.y + player.h / 2;
            trail.push({ x: cx, y: cy, color: rainbow(), alpha: 1.0 });
            if (trail.length > 120) trail.shift();
        }

        function drawTrail() {
            trail.forEach((t, i) => {
                ctx.globalAlpha = t.alpha * (i / trail.length);
                ctx.fillStyle = t.color;
                ctx.beginPath();
                ctx.arc(t.x, t.y, 3, 0, Math.PI * 2);
                ctx.fill();
            });
            ctx.globalAlpha = 1;
        }

        function createObstacle() {
            const gapY = Math.floor(Math.random() * (280 - 120 + 1)) + 120;
            const gapSize = Math.max(90, 140 - Math.floor(score / 10));
            obstacles.push({
                x: WIDTH,
                topH: gapY - gapSize / 2,
                bottomY: gapY + gapSize / 2,
                passed: false
            });
        }

        function drawObstacles() {
            ctx.fillStyle = "#cc2222";
            obstacles.forEach(obs => {
                ctx.fillRect(obs.x, 0, 40, obs.topH);
                ctx.fillRect(obs.x, obs.bottomY, 40, HEIGHT - obs.bottomY);
            });
        }

        function checkCollision(obs) {
            const margin = 8;
            const px = player.x + margin;
            const py = player.y + margin;
            const pw = player.w - margin * 2;
            const ph = player.h - margin * 2;

            if (px + pw > obs.x && px < obs.x + 40) {
                if (py < obs.topH || py + ph > obs.bottomY) return true;
            }
            return false;
        }

        let shakeOffset = { x: 0, y: 0 };
        let shakeTicks = 0;

        function triggerShake() { shakeTicks = 12; }

        function movePlayer() {
            if (holding) velocityY += wavePower;
            else velocityY += gravity;

            velocityY = Math.max(-6, Math.min(6, velocityY));
            player.y += velocityY;

            addTrail();

            if (player.y < 0) { player.y = 0; velocityY = 0; }
            if (player.y + player.h > HEIGHT) { player.y = HEIGHT - player.h; velocityY = 0; }
        }

        let frameCount = 0;

        function gameLoop() {
            frameCount++;

            if (shakeTicks > 0) {
                shakeOffset.x = (Math.random() - 0.5) * 10;
                shakeOffset.y = (Math.random() - 0.5) * 10;
                shakeTicks--;
            } else {
                shakeOffset.x = 0;
                shakeOffset.y = 0;
            }

            ctx.save();
            ctx.translate(shakeOffset.x, shakeOffset.y);
            ctx.clearRect(-10, -10, WIDTH + 20, HEIGHT + 20);
            ctx.fillStyle = "#000";
            ctx.fillRect(-10, -10, WIDTH + 20, HEIGHT + 20);

            if (!gameOver) {
                movePlayer();

                const speed = 10 + Math.floor(score / 10);
                for (let i = obstacles.length - 1; i >= 0; i--) {
                    obstacles[i].x -= speed;
                    if (obstacles[i].x + 40 < 0) {
                        obstacles.splice(i, 1);
                        score++;
                        continue;
                    }
                    if (checkCollision(obstacles[i])) {
                        gameOver = true;
                        triggerShake();
                    }
                }

                const spawnChance = Math.max(25, 45 - score);
                if (Math.floor(Math.random() * spawnChance) === 0) {
                    createObstacle();
                }
            }

            drawTrail();
            drawObstacles();
            drawPlayer();

            ctx.fillStyle = "white";
            ctx.font = "bold 18px Arial";
            ctx.fillText(`Score: ${score}`, 20, 30);

            if (gameOver) {
                ctx.fillStyle = "rgba(0,0,0,0.5)";
                ctx.fillRect(0, 0, WIDTH, HEIGHT);
                ctx.fillStyle = "white";
                ctx.font = "bold 36px Arial";
                ctx.textAlign = "center";
                ctx.fillText("GAME OVER", WIDTH / 2, HEIGHT / 2 - 20);
                ctx.font = "22px Arial";
                ctx.fillText("Press R or tap to restart", WIDTH / 2, HEIGHT / 2 + 20);
                ctx.textAlign = "left";
            }

            ctx.restore();
            animFrame = requestAnimationFrame(gameLoop);
        }

        function restart() {
            if (animFrame) cancelAnimationFrame(animFrame);
            initGame();
            gameLoop();
        }

        document.addEventListener("keydown", e => {
            if (e.code === "Space") { e.preventDefault(); holding = true; }
            if (e.code === "KeyR") restart();
        });
        document.addEventListener("keyup", e => {
            if (e.code === "Space") holding = false;
        });

        canvas.addEventListener("mousedown", () => { if (gameOver) restart(); else holding = true; });
        canvas.addEventListener("mouseup", () => { holding = false; });
        canvas.addEventListener("touchstart", e => {
            e.preventDefault();
            if (gameOver) restart(); else holding = true;
        });
        canvas.addEventListener("touchend", e => {
            e.preventDefault();
            holding = false;
        });

        initGame();
        gameLoop();
    </script>
</body>
</html>
